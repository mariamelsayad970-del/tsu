rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mariammohamedelsyad@gmail.com';
    }
    // أي زائر يقرأ، والأدمن بس يكتب
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
